DISCORD_TOKEN=your_bot_token_here
CLOUDFLARED_BIN=cloudflared

# Optional paths to host-installed media tools (not downloaded by the bot)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Movie web server
MOVIE_HOST=0.0.0.0
MOVIE_PORT=8080

# External Lavalink on Render
LAVALINK_URI=https://movie-bot-lavalink2.onrender.com
LAVALINK_PASSWORD=your_lavalink_password_here

# YouTube extractor
# Optional Netscape-format cookies from an authenticated YouTube session.
# Do not commit this file or paste its contents into chat.
YOUTUBE_COOKIES_FILE=/home/container/secrets/youtube-cookies.txt
YOUTUBE_PROXY=
